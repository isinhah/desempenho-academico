# Em desenvolvimento, deixe vazio para usar o proxy /api -> http://localhost:8000.
# Em produção, informe a URL pública da API, sem barra final.
# VITE_API_URL=https://api.exemplo.com

# Supabase Auth: Project Settings > API.
# Use somente a URL do projeto e a chave anon/publishable; nunca a service_role.
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_OU_PUBLISHABLE